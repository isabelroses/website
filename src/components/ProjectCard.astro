---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import type { PROJECTS } from "@lib/consts";

// resolved here rather than in consts so the client bundle never pulls images
const icons = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/repos/*",
  { eager: true },
);

interface Props {
  project: (typeof PROJECTS)[number];
  truncate?: boolean;
}

const { project, truncate = false } = Astro.props;
const { name, description, icon, stars } = project;
const href = project.href ?? project.repo;
const iconSrc = icon ? icons[`/src/assets/repos/${icon}`]?.default : undefined;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="row-link icon-row group"
>
  <span class="icon-tile">
    {iconSrc ? (
      <Image
        src={iconSrc}
        alt=""
        width={96}
        height={96}
        class="w-[68%] h-[68%] object-contain"
      />
    ) : (
      <span
        aria-hidden="true"
        class="font-display text-[1.75rem] leading-none text-fg-lighter group-hover:text-on-blood transition-colors"
      >
        {name.charAt(0)}
      </span>
    )}
  </span>
  <span class="flex flex-col gap-1 min-w-0">
    <span class="item-title group-hover-special">{name}</span>
    <span class:list={["text-fg-lighter", truncate && "truncate"]}>
      {description}
    </span>
  </span>
  <span class="flex items-center gap-2 shrink-0 text-meta text-fg-lighter tabular-nums">
    <Icon aria-hidden="true" name="fa7-solid:star" class="w-4 h-4" />
    {stars}
    <span class="sr-only">stars</span>
  </span>
</a>
