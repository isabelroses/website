---
import type { CollectionEntry } from "astro:content";
import { formatDate, formatReadTime } from "@lib/format";
import { postPath } from "@lib/url";

interface Props {
  post: CollectionEntry<"blog">;
  withYear?: boolean;
  showTags?: boolean;
}

const { post, withYear = true, showTags = false } = Astro.props;
const { title, date, description, readTime, tags } = post.data;
const id = `post-${post.id}`;
---

<a
  href={postPath(post)}
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-desc ${id}-meta`}
  class="row-link group grid gap-x-8 gap-y-1 py-4 sm:grid-cols-[1fr_auto] sm:items-baseline"
>
  <span class="flex flex-col gap-1">
    <span id={`${id}-title`} class="item-title group-hover-special">
      {title}
    </span>
    <span id={`${id}-desc`}>{description}</span>
    {showTags && (
      <span class="flex flex-wrap gap-x-3 text-meta text-fg-lighter">
        {tags.map((tag) => (
          <span>#{tag}</span>
        ))}
      </span>
    )}
  </span>
  <span
    id={`${id}-meta`}
    class="text-meta text-fg-lighter tabular-nums whitespace-nowrap sm:text-right"
  >
    <time datetime={date.toISOString()}>
      {formatDate(date, "short", withYear)}
    </time>
    · {formatReadTime(readTime)}
  </span>
</a>
