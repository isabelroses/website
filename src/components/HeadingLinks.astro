---
import CopyIcons from "@components/CopyIcons.astro";
---

<template data-heading-link>
  <span class="whitespace-nowrap">
    <span class="not-prose">
      <a
        data-copy
        class="group -ml-[0.12em] inline-grid place-items-center align-middle relative -top-[0.06em] w-[1.4em] h-[1.4em] -my-[0.2em] text-fg-lighter hover:text-special focus-visible:opacity-100 opacity-0 group-hover/heading:opacity-100 pointer-coarse:opacity-100 transition-[opacity,color] duration-150"
      >
        <CopyIcons icon="fa7-solid:link" size="w-[0.55em] h-[0.55em]" inline />
      </a>
    </span>
  </span>
</template>

<script>
  document.addEventListener("astro:page-load", () => {
    const template = document.querySelector<HTMLTemplateElement>(
      "template[data-heading-link]",
    );
    if (!template) return;

    document
      .querySelectorAll<HTMLHeadingElement>(".prose :is(h2, h3, h4)[id]")
      .forEach((heading) => {
        const wrapper = template.content.firstElementChild!.cloneNode(true);
        const link = (wrapper as Element).querySelector("a")!;
        link.href = `#${heading.id}`;
        link.setAttribute("aria-label", `copy link to ${heading.textContent}`);

        // carry the last word into the nowrap wrapper so the icon never wraps alone
        const tail = heading.lastChild;
        if (tail?.nodeType === Node.TEXT_NODE) {
          const text = tail.textContent!.trimEnd();
          const at = text.search(/\S+$/);
          if (at !== -1) {
            wrapper.insertBefore(
              document.createTextNode(text.slice(at)),
              wrapper.firstChild,
            );
            tail.textContent = text.slice(0, at);
          }
        } else if (tail) {
          wrapper.insertBefore(tail, wrapper.firstChild);
        }

        heading.classList.add("group/heading");
        heading.append(wrapper);
      });
  });
</script>
