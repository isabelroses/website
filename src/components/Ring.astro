---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  class:list={["sigil-ring text-special", className]}
  viewBox="0 0 200 200"
  fill="none"
  stroke="currentColor"
>
  <circle cx="100" cy="100" r="98" stroke-width="0.5" stroke-dasharray="1 3" />
  <circle cx="100" cy="100" r="90" stroke-width="1" />
  <g transform="rotate(30 100 100)" stroke-width="0.5">
    <path d="M100 10 L190 150 L10 150 Z" />
    <path d="M100 190 L10 50 L190 50 Z" />
  </g>
  <circle cx="100" cy="100" r="40" stroke-width="0.5" />
  <path
    class="sigil-ring-core"
    d="M80 100 L100 80 L120 100 L100 120 Z"
    fill="currentColor"
    stroke="none"
  />
  <path
    d="M40 40 L60 60 M140 140 L160 160 M40 160 L60 140 M160 40 L140 60"
    stroke-width="2"
  />
</svg>

<style>
  .sigil-ring {
    animation: ring-spin 120s linear infinite;
  }

  .sigil-ring-core {
    transform-origin: 100px 100px;
    animation: ring-pulse 4s ease-in-out infinite alternate;
  }

  @keyframes ring-spin {
    to {
      rotate: 360deg;
    }
  }

  @keyframes ring-pulse {
    from {
      opacity: 0.4;
    }
    to {
      opacity: 0.8;
      scale: 1.05;
    }
  }
</style>
