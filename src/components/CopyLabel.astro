---
import CopyIcons from "@components/CopyIcons.astro";

interface Props {
  what: string;
  label?: string;
}

const { what, label = "copy" } = Astro.props;
---

<span class="flex items-center gap-2 text-meta text-fg-lighter group-hover-special">
  <CopyIcons icon="fa7-solid:copy" size="w-5 h-5" />
  <span class="grid">
    <span class="col-start-1 row-start-1 group-data-copied:invisible">
      {label}
      <span class="sr-only"> {what}</span>
    </span>
    <span class="col-start-1 row-start-1 invisible group-data-copied:visible">
      copied
    </span>
  </span>
</span>
