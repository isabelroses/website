---
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  size: string;
  inline?: boolean;
  class?: string;
}

const { icon, size, inline = false, class: className } = Astro.props;
const swap = "col-start-1 row-start-1 transition-[opacity,scale] duration-200";
---

<span class:list={["grid", className]}>
  <Icon
    aria-hidden="true"
    is:inline={inline}
    name={icon}
    class:list={[
      swap,
      size,
      "group-data-copied:opacity-0 group-data-copied:scale-50",
    ]}
  />
  <Icon
    aria-hidden="true"
    is:inline={inline}
    name="fa7-solid:check"
    class:list={[
      swap,
      size,
      "opacity-0 scale-50 text-special group-data-copied:opacity-100 group-data-copied:scale-100",
    ]}
  />
</span>
