---
import { Icon } from "astro-icon/components";
---

<button
  id="theme-toggle"
  type="button"
  class="inline-flex items-center justify-center w-11 h-11 -mr-3 text-fg hover:text-special transition-[color,scale] duration-150 active:scale-90 cursor-pointer"
  title="switch theme"
>
  <Icon aria-hidden="true" name="fa7-solid:moon" class="light:hidden w-4 h-4" />
  <Icon
    aria-hidden="true"
    name="fa7-solid:sun"
    class="hidden light:inline-block w-4 h-4"
  />
  <span class="light:hidden sr-only">switch to light theme</span>
  <span class="hidden light:inline sr-only">switch to dark theme</span>
</button>
