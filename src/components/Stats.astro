---
interface Props {
  items: { label: string; value: string | number }[];
}

const { items } = Astro.props;
---

<dl class="flex flex-wrap gap-4">
  {items.map((item) => (
    <div class="flex flex-col gap-2 flex-1 min-w-36 sm:flex-none sm:min-w-50 bg-card p-5 sm:p-6">
      <dt class="caption">{item.label}</dt>
      <dd class="text-sub tabular-nums">{item.value}</dd>
    </div>
  ))}
</dl>
