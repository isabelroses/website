---
interface Props {
  items: { label: string; value: string | number }[];
}

const { items } = Astro.props;
---

<dl class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-meta text-fg-lighter">
  {items.map((item, index) => (
    <div class="inline-flex items-baseline gap-1">
      <dt class="order-2">{item.label}</dt>
      <dd class="font-semibold tabular-nums text-fg">
        {typeof item.value === "number" ? item.value.toLocaleString("en-GB") : item.value}
      </dd>
      {index < items.length - 1 && <span class="order-3" aria-hidden="true">·</span>}
    </div>
  ))}
</dl>
