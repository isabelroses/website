---
import { Icon } from "astro-icon/components";
import { ATPROTO, LASTFM_PROFILE } from "@lib/consts";
---

<link rel="preconnect" href={ATPROTO.pds} crossorigin />
<link rel="preconnect" href="https://coverartarchive.org" />
<link rel="preconnect" href="https://archive.org" />
<link rel="dns-prefetch" href="https://itunes.apple.com" />
<link rel="dns-prefetch" href="https://is1-ssl.mzstatic.com" />

<a
  class="group grid grid-cols-[7rem_1fr] sm:grid-cols-[9rem_1fr] gap-5 items-end lg:grid-cols-1 lg:items-start lg:w-56 lg:justify-self-end"
  data-nowplaying
  href={LASTFM_PROFILE}
  target="_blank"
  rel="noopener noreferrer"
>
  <div class="relative aspect-square bg-card overflow-hidden">
    <div
      class="absolute inset-0 grid place-items-center text-fg-lighter"
      data-np-art-fallback
    >
      <Icon aria-hidden="true" name="fa7-solid:music" class="w-8 h-8" />
    </div>
    <img
      data-np-art
      alt=""
      width="500"
      height="500"
      class="absolute inset-0 w-full h-full object-cover"
      hidden
    />
  </div>

  <div class="min-w-0 flex flex-col gap-1 pb-1">
    <p data-np-state class="text-meta text-fg-lighter">
      on last.fm
    </p>
    <p data-np-title class="item-title break-words group-hover-special">
      loading…
    </p>
    <p data-np-artist class="text-meta text-fg-lighter truncate">
      connecting…
    </p>
  </div>
</a>

<script>
  import { LASTFM_PROFILE } from "@lib/consts";
  import { currentTrack, itunesArt } from "@lib/now-playing";

  async function updateNowPlaying() {
    const root = document.querySelector<HTMLAnchorElement>("[data-nowplaying]");
    if (!root) return;

    const titleEl = root.querySelector<HTMLElement>("[data-np-title]")!;
    const artistEl = root.querySelector<HTMLElement>("[data-np-artist]")!;
    const stateEl = root.querySelector<HTMLElement>("[data-np-state]")!;
    const artEl = root.querySelector<HTMLImageElement>("[data-np-art]")!;
    const fallbackEl = root.querySelector<HTMLElement>(
      "[data-np-art-fallback]",
    )!;

    const showFallback = (msg: string) => {
      titleEl.textContent = "not scrobbling";
      artistEl.textContent = msg;
      stateEl.textContent = "on last.fm";
      root.href = LASTFM_PROFILE;
      artEl.hidden = true;
      fallbackEl.hidden = false;
    };

    try {
      const track = await currentTrack(fetch);
      if (!track) {
        showFallback("nothing playing right now");
        return;
      }

      titleEl.textContent = track.title;
      artistEl.textContent = track.artist;
      stateEl.textContent = track.live
        ? "listening to, right now"
        : "last listened to";
      root.href = track.href;

      artEl.hidden = true;
      fallbackEl.hidden = false;
      artEl.alt = `cover of ${track.album}`;
      artEl.onload = () => {
        artEl.hidden = false;
        fallbackEl.hidden = true;
      };

      const loadItunes = async () => {
        artEl.onerror = null;
        const art = await itunesArt(fetch, track);
        if (art) artEl.src = art;
      };

      if (track.coverArt) {
        artEl.onerror = loadItunes;
        artEl.src = track.coverArt;
      } else {
        await loadItunes();
      }
    } catch {
      showFallback("couldn't reach last.fm");
    }
  }

  document.addEventListener("astro:page-load", updateNowPlaying);
</script>
