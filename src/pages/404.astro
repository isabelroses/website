---
import PageLayout from "@layouts/PageLayout.astro";
import Section from "@components/Section.astro";
import { PAGES } from "@lib/pages";
import { getCatalogue } from "@lib/posts";
import { postPath } from "@lib/url";

const posts = (await getCatalogue()).posts.slice(0, 3);

const links = [
  { href: "/", label: "home" },
  ...posts.map((post) => ({
    href: postPath(post),
    label: post.data.title,
  })),
  { href: PAGES.blog.path, label: "every post" },
];
---

<PageLayout page={PAGES.notFound}>
  <Section id="elsewhere" title="try one of these">
    <ul class="flex flex-col">
      {links.map((link) => (
        <li>
          <a href={link.href} class="row-link group block py-4">
            <span class="item-title group-hover-special">{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>
</PageLayout>
