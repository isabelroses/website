---
import PageLayout from "@layouts/PageLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";

import { PAGES, PROJECTS } from "@lib/consts";
---

<PageLayout title="projects" page={PAGES.projects}>
  <ul class="checker grid md:grid-cols-2">
    {PROJECTS.map((project) => (
      <li class="min-w-0">
        <ProjectCard project={project} />
      </li>
    ))}
  </ul>
</PageLayout>
