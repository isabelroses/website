---
import PageLayout from "@layouts/PageLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";

import { PROJECTS, TOTAL_STARS } from "@lib/consts";
import { PAGES } from "@lib/pages";
---

<PageLayout
  page={PAGES.projects}
  stats={[
    { label: "artifacts", value: PROJECTS.length },
    { label: "total_stars", value: TOTAL_STARS },
  ]}
>
  <ul class="checker grid md:grid-cols-2">
    {PROJECTS.map((project) => (
      <li class="min-w-0">
        <ProjectCard project={project} />
      </li>
    ))}
  </ul>
</PageLayout>
