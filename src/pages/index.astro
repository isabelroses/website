---
import { Image } from "astro:assets";

import Base from "@layouts/Base.astro";
import { Icon } from "astro-icon/components";

import Label from "@components/Label.astro";
import NowPlaying from "@components/NowPlaying.astro";
import Portal from "@components/Portal.astro";
import PostCard from "@components/PostCard.astro";
import ProjectCard from "@components/ProjectCard.astro";
import Section from "@components/Section.astro";
import Stats from "@components/Stats.astro";

import { LINKS, PROJECTS, TOTAL_STARS } from "@lib/consts";
import { PAGES, pageImage, pageTitle } from "@lib/pages";
import { getCatalogue } from "@lib/posts";

import avatar from "../assets/me.webp";

const { posts } = await getCatalogue();

const [latest, ...rest] = posts;
const recent = rest.slice(0, 3);
---

<Base
  title={pageTitle()}
  description={PAGES.index.description}
  image={pageImage(PAGES.index)}
>
  <Portal slot="portal" />

  <section
    aria-labelledby="intro-title"
    class="grid gap-12 pt-16 lg:pt-24 lg:grid-cols-12 lg:items-center lg:gap-16"
  >
    <div class="flex flex-col gap-8 lg:col-span-8">
      <h1 id="intro-title" class="sr-only">
        isabel, the nix witch
      </h1>
      <Label text="intro.v1.0.0">
        <Image
          src={avatar}
          alt="isabel's avatar: a drawn girl with long blonde hair and a dark top"
          width={112}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
          class="w-20 h-20 sm:w-28 sm:h-28 object-cover shrink-0"
        />
      </Label>

      <!-- reflowing this puts spaces inside the links, before the punctuation -->
      <!-- prettier-ignore -->
      <p class="lede">
        i am a <a href="https://github.com/NixOS/org/blob/main/doc/nixpkgs-committers.md" target="_blank" rel="noopener noreferrer" class="link">nixpkgs committer (i can merge prs)</a>,
        and for a little fun i also <a href="https://catppuccin.com/community/" target="_blank" rel="noopener noreferrer" class="link">moderate for catppuccin</a>.
        i write a lot of nix, so expect plenty of my thoughts on that here.
      </p>
      <a href="/isabel_roses_cv.pdf" class="link self-start py-2 -my-2 -mt-4">
        my cv (pdf) →
      </a>

      <Stats
        items={[
          { label: "logs_published", value: posts.length },
          { label: "artifact_stars", value: TOTAL_STARS },
        ]}
      />
    </div>

    <div class="relative flex items-center justify-center lg:col-span-4 lg:py-12">
      <div
        aria-hidden="true"
        class="absolute size-72 rotate-45 border border-blood/40 max-lg:hidden"
      ></div>
      <div
        aria-hidden="true"
        class="absolute size-72 border border-special/20 max-lg:hidden"
      ></div>
      <NowPlaying />
    </div>
  </section>

  <Section
    id="writing"
    class="mt-16 lg:mt-24"
    title={PAGES.blog.name}
    link={{ href: PAGES.blog.path, label: "view all posts" }}
  >
    <div class="grid gap-x-12 gap-y-6 lg:grid-cols-2">
      {latest && <PostCard post={latest} variant="featured" />}

      <ol class="flex flex-col">
        {recent.map((post) => (
          <li class="flex flex-1 flex-col">
            <PostCard post={post} variant="compact" />
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <Section
    id="projects"
    class="mt-16 lg:mt-24"
    title={PAGES.projects.name}
    link={{ href: PAGES.projects.path, label: "view full registry" }}
  >
    <ul class="grid gap-x-12 md:grid-cols-2">
      {PROJECTS.slice(0, 4).map((project) => (
        <li class="min-w-0">
          <ProjectCard project={project} truncate />
        </li>
      ))}
    </ul>
  </Section>

  <Section id="elsewhere" title="channels" class="mt-16 lg:mt-24">
    <ul class="flex flex-col gap-y-4 md:grid md:grid-cols-3 md:gap-x-10 xl:flex xl:flex-row xl:justify-between xl:gap-x-6">
      {LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="me noopener noreferrer"
            class="group flex items-center gap-3 py-1"
          >
            <Icon
              aria-hidden="true"
              name={link.icon}
              class="w-5 h-5 shrink-0 text-fg-lighter group-hover-special"
            />
            <span class="flex flex-col leading-tight">
              <span class="font-semibold group-hover-special">
                {link.label}
              </span>
              <span class="text-fg-lighter">{link.handle}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Section>
</Base>

<style>
  .lede {
    max-width: 64ch;
  }
</style>
