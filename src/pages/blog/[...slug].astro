---
import { type CollectionEntry, render } from "astro:content";

import Base from "@layouts/Base.astro";
import SharePost from "@components/SharePost.astro";
import HeadingLinks from "@components/HeadingLinks.astro";
import CodeBlocks from "@components/CodeBlocks.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Tag from "@components/Tag.astro";

import { formatDate, formatReadTime } from "@lib/format";
import { getPosts } from "@lib/posts";
import { postPath } from "@lib/url";

export async function getStaticPaths() {
  const posts = await getPosts({ includeArchived: true });
  const visible = posts.filter((post) => !post.data.archived);

  return posts.map((post) => {
    const i = visible.indexOf(post);
    return {
      params: { slug: post.id },
      props: {
        post,
        prevPost: i === -1 ? null : (visible[i + 1] ?? null),
        nextPost: i === -1 ? null : (visible[i - 1] ?? null),
      },
    };
  });
}

interface Props {
  post: CollectionEntry<"blog">;
  prevPost: CollectionEntry<"blog"> | null;
  nextPost: CollectionEntry<"blog"> | null;
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const postUrl = new URL(postPath(post), Astro.site).href;
---

<Base
  title={`isabel | ${post.data.title}`}
  description={post.data.description}
  image={`${postPath(post)}.png`}
  aturi={post.data.atUri}
  published={post.data.date}
  updated={post.data.updated}
>
  <article class="grid gap-y-10 pt-10 lg:pt-14 lg:grid-cols-[11rem_minmax(0,72ch)] lg:justify-center lg:gap-x-16 lg:gap-y-12">
    <h1 class="lg:col-start-2 text-[clamp(2.25rem,4vw,3.25rem)] font-semibold leading-[1.1] text-balance">
      {post.data.title}
    </h1>

    {/* below lg this dissolves so share can be ordered after the post */}
    <div class="max-lg:contents lg:flex flex-col gap-3 lg:col-start-1 lg:row-start-2 lg:row-span-2 lg:text-meta">
      <dl class="flex flex-wrap gap-x-3 gap-y-1 text-meta max-lg:text-fg-lighter lg:flex-col lg:gap-3">
        <div>
          <dt class="max-lg:sr-only text-fg-lighter">published</dt>
          <dd>
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date, "long")}
            </time>
          </dd>
        </div>
        {post.data.updated && (
          <div class="max-lg:order-1 max-lg:basis-full">
            <dt class="max-lg:sr-only text-fg-lighter">updated</dt>
            <dd>
              <span class="lg:hidden" aria-hidden="true">
                updated{" "}
              </span>
              <time datetime={post.data.updated.toISOString()}>
                {formatDate(post.data.updated, "long")}
              </time>
            </dd>
          </div>
        )}
        <div class="max-lg:before:content-['·'] max-lg:before:mr-3 max-lg:flex">
          <dt class="max-lg:sr-only text-fg-lighter">reading</dt>
          <dd>
            {formatReadTime(post.data.readTime)}
            <span class="lg:hidden"> read</span>
          </dd>
        </div>
        <div class="max-lg:hidden">
          <dt class="max-lg:sr-only text-fg-lighter">tags</dt>
          {post.data.tags.map((tag) => (
            <dd>
              <Tag tag={tag} class="lg:py-0 lg:text-fg" />
            </dd>
          ))}
        </div>
      </dl>
      <div class="max-lg:contents lg:sticky lg:top-10 lg:mt-6 lg:flex lg:flex-col lg:gap-6">
        <TableOfContents headings={headings} class="max-lg:hidden" />
        <SharePost
          title={post.data.title}
          url={postUrl}
          class="max-lg:order-1"
        />
      </div>
    </div>

    <div class="prose min-w-0 lg:col-start-2 lg:row-start-2">
      <Content />
    </div>
    <HeadingLinks />
    <CodeBlocks />

    <nav
      aria-label="more posts"
      class:list={[
        "grid gap-x-8 gap-y-2 max-lg:order-2 lg:col-start-2 lg:row-start-3",
        prevPost && nextPost && "sm:grid-cols-2",
      ]}
    >
      {prevPost && (
        <a
          href={postPath(prevPost)}
          class="row-link group flex flex-col gap-1 py-4"
        >
          <span class="text-meta text-fg-lighter">← previous</span>
          <span class="item-title group-hover-special">
            {prevPost.data.title}
          </span>
        </a>
      )}
      {nextPost && (
        <a
          href={postPath(nextPost)}
          class="row-link group flex flex-col gap-1 py-4 sm:text-right"
        >
          <span class="text-meta text-fg-lighter">next →</span>
          <span class="item-title group-hover-special">
            {nextPost.data.title}
          </span>
        </a>
      )}
    </nav>
  </article>
</Base>
