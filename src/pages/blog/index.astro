---
import PageLayout from "@layouts/PageLayout.astro";
import Tag from "@components/Tag.astro";
import PostCard from "@components/PostCard.astro";

import { SITE_DESCRIPTIONS } from "@lib/consts";
import { getPosts, getTags } from "@lib/posts";

const posts = await getPosts();

const years = Map.groupBy(posts, (post) => post.data.date.getFullYear());
---

<PageLayout
  title="blog"
  description={SITE_DESCRIPTIONS.blog}
  image="/blog/index.png"
>
  <nav aria-label="tags" class="flex flex-wrap gap-x-5 gap-y-1 -mt-6">
    {getTags(posts).map((tag) => (
      <Tag tag={tag} />
    ))}
  </nav>

  {[...years].map(([year, yearPosts]) => (
    <section
      class="grid gap-x-12 gap-y-2 lg:grid-cols-[8rem_minmax(0,1fr)]"
      aria-labelledby={`year-${year}`}
    >
      <h2
        id={`year-${year}`}
        class="heading tabular-nums lg:sticky lg:top-10 lg:self-start lg:py-5"
      >
        {year}
      </h2>
      <ul class="flex flex-col">
        {yearPosts.map((post) => (
          <li>
            <PostCard post={post} withYear={false} showTags />
          </li>
        ))}
      </ul>
    </section>
  ))}
</PageLayout>
