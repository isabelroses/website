---
import PageLayout from "@layouts/PageLayout.astro";
import PostCard from "@components/PostCard.astro";
import Section from "@components/Section.astro";

import { PAGES } from "@lib/pages";
import { getCatalogue, type TagPage } from "@lib/posts";

type Props = TagPage;

const { posts, tag } = Astro.props;

export async function getStaticPaths() {
  return (await getCatalogue()).tagPages.map((props) => ({
    params: { slug: props.tag },
    props,
  }));
}
---

<PageLayout
  page={PAGES.blog}
  label="grimoire.tag"
  title={`#${tag}`}
  description={`${posts.length} post${posts.length !== 1 ? "s" : ""} tagged with #${tag}`}
  metaDescription={`posts tagged with #${tag}`}
>
  <Section id="tagged" title="posts">
    <ul class="flex flex-col max-w-5xl">
      {posts.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))}
    </ul>
  </Section>
</PageLayout>
