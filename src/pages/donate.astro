---
import { Icon } from "astro-icon/components";

import PageLayout from "@layouts/PageLayout.astro";
import CopyLabel from "@components/CopyLabel.astro";
import Section from "@components/Section.astro";

const DONATION_OPTIONS = [
  {
    name: "Ko-fi",
    description: "buy me a coffee, one-off or monthly.",
    href: "https://ko-fi.com/isabelroses",
    icon: "kofi",
  },
  {
    name: "GitHub Sponsors",
    description: "sponsor me directly through github.",
    href: "https://github.com/sponsors/isabelroses",
    icon: "fa7-brands:github",
  },
];

const CRYPTO_OPTIONS = [
  {
    name: "Bitcoin",
    address: "bc1qu8e5xefa0f6vrfy2rp6n8k2usgph9vkqz33ul3",
    icon: "fa7-brands:bitcoin",
  },
  {
    name: "Ethereum",
    address: "0xAe39F3172dD4075AaE695824Fbc702c096218C7a",
    icon: "fa7-brands:ethereum",
  },
  {
    name: "Monero",
    address:
      "45pYxmERBuf7e8hT1MSUthML3fs8puswxSeTCm9AMq3oij1PCjxo4cqiJBKEmi2v71MJGMeXgKAr6f6p7sLE5LSzS338zJz",
    icon: "fa7-brands:monero",
  },
];
---

<PageLayout
  title="donate"
  metaDescription="support my open source work"
  description="i spend a lot of my free time on open source projects and writing blog posts. any amount is greatly appreciated, thank you."
>
  <Section id="support" title="ways to support">
    <ul class="grid gap-x-12 md:grid-cols-2">
      {DONATION_OPTIONS.map((option) => (
        <li>
          <a
            href={option.href}
            target="_blank"
            rel="noopener noreferrer"
            class="row-link icon-row group"
          >
            <span class="icon-tile">
              <Icon aria-hidden="true" name={option.icon} class="w-7 h-7" />
            </span>
            <span class="flex flex-col gap-1 min-w-0">
              <span class="item-title group-hover-special">{option.name}</span>
              <span class="text-fg-lighter">{option.description}</span>
            </span>
            <Icon
              aria-hidden="true"
              name="fa7-solid:arrow-up-right-from-square"
              class="w-4 h-4 shrink-0 text-fg-lighter"
            />
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="crypto" title="crypto">
    <ul class="flex flex-col">
      {CRYPTO_OPTIONS.map((option) => (
        <li>
          <button
            type="button"
            data-copy={option.address}
            class="row-link group grid w-full grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-x-4 py-4 text-left cursor-pointer"
          >
            <Icon
              aria-hidden="true"
              name={option.icon}
              class="w-8 h-8 text-fg-lighter"
            />
            <span class="flex flex-col gap-1">
              <span class="item-title group-hover-special">{option.name}</span>
              <code
                aria-hidden="true"
                class="font-mono text-meta text-fg-lighter break-all"
              >
                {option.address}
              </code>
            </span>
            <CopyLabel what="address" />
          </button>
        </li>
      ))}
    </ul>
  </Section>
</PageLayout>
