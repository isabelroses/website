---
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import type { ComponentProps } from "astro/types";

type Props = ComponentProps<typeof BaseHead>;

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...props} />
  </head>

  <body class="min-h-svh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-blood focus:text-on-blood"
    >
      skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="page-width flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <span data-copy-status class="sr-only" role="status"></span>

    <script>
      import "@lib/clipboard";
    </script>
  </body>
</html>
