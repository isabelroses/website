---
import Base from "@layouts/Base.astro";
import Label from "@components/Label.astro";
import Ring from "@components/Ring.astro";
import Stats from "@components/Stats.astro";
import { pageImage, pageTitle, type Page } from "@lib/pages";
import type { ComponentProps } from "astro/types";

interface Props {
  page: Page;
  title?: string;
  label?: string;
  description?: string;
  metaDescription?: string;
  stats?: ComponentProps<typeof Stats>["items"];
}

const {
  page,
  title = page.name,
  label = page.label,
  description = page.description,
  metaDescription = description,
  stats,
} = Astro.props;
---

<Base
  title={pageTitle(title)}
  description={metaDescription}
  image={pageImage(page)}
>
  <div class="grid gap-10 pt-10 lg:pt-14 lg:grid-cols-12 lg:items-center lg:gap-16">
    <div class="flex flex-col gap-6 lg:col-span-8">
      {label && <Label text={label} />}
      <h1 class="font-display leading-none break-words text-[clamp(3rem,6vw,4.5rem)]">
        {title}
      </h1>
      <p class="lede text-fg-lighter">{description}</p>
      {stats && <Stats items={stats} />}
    </div>
    <div class="max-lg:hidden lg:col-span-4 flex justify-center">
      <Ring class="w-64 opacity-60" />
    </div>
  </div>

  <div class="flex flex-col gap-16 mt-12 lg:mt-16 lg:gap-24">
    <slot />
  </div>
</Base>
